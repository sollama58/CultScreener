# ===========================================
# HolDEX API Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ===========================================
# Database (Required)
# ===========================================
DATABASE_URL=postgresql://user:password@host:5432/holdex

# ===========================================
# Redis (Required for job queue)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# API Keys
# ===========================================

# Helius RPC (Required for holder analysis)
HELIUS_API_KEY=your_helius_api_key_here

# CoinGecko Pro API (Optional - for higher GeckoTerminal rate limits)
# COINGECKO_API_KEY=your_coingecko_pro_api_key_here
# Without a key (or if it is rejected) the free API allows 30 req/min; the API and worker
# each pace themselves to GECKO_FREE_RPM, so set it lower on each to split that budget
# GECKO_FREE_RPM=30

# ===========================================
# Admin
# ===========================================

# Password for managing curated tokens
ADMIN_PASSWORD=your_admin_password_here

# ADMIN_PASSWORD may be a hash instead: scrypt:<salt_hex>:<hash_hex> from scripts/hash-password.js.
# (No cookie secret is needed: the admin session cookie is a random token checked against the
# admin_sessions table, so it is not signed, and sessions survive restarts.)

# ===========================================
# Server Configuration
# ===========================================

PORT=3000
NODE_ENV=development

# CORS - comma-separated origins allowed
CORS_ORIGIN=http://localhost:5500,http://localhost:3000,http://127.0.0.1:5500

# ===========================================
# Rate Limiting
# ===========================================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Stricter limits on sensitive routes (Optional - defaults shown)
# STRICT_RATE_LIMIT_WINDOW_MS=60000
# STRICT_RATE_LIMIT_MAX=10
# VERY_STRICT_RATE_LIMIT_WINDOW_MS=3600000
# VERY_STRICT_RATE_LIMIT_MAX=5

# Cache TTLs are fixed in src/services/cache.js; there are no env vars for them.

# ===========================================
# Database Pool (Optional - defaults shown)
# ===========================================
# DB_POOL_MAX=10   (20 when NODE_ENV=production)
# DB_POOL_MIN=2
# DB_SSL_REJECT_UNAUTHORIZED=false

# ===========================================
# Worker (Optional - defaults shown)
# ===========================================
# WORKER_CONCURRENCY=2
# WORKER_LIMITER_MAX=3
# How long a SIGTERM drain waits for active jobs before exiting without them
# WORKER_SHUTDOWN_DEADLINE_MS=270000
# Helius requests/s the worker uses while draining (a deploy runs it beside the new worker).
# Lower values drain Helius-heavy jobs slower, so they may pass the deadline and re-run.
# WORKER_DRAIN_HELIUS_RPS=15

# ===========================================
# Helius budget (Optional - defaults shown)
# ===========================================
# Requests/s this process may start. API and worker each have their own limiter;
# keep their sum (plus a draining worker during deploys) under the plan's limit.
# HELIUS_RPS=40
# HELIUS_MAX_CONCURRENT=24
# Plan credits per month, for the usage page's budget line
# HELIUS_MONTHLY_CREDITS=10000000
# Curated tokens are re-snapshotted at most this often
# HOLDER_SNAPSHOT_REFRESH_HOURS=4

# ===========================================
# Telegram Bot (Optional)
# ===========================================

# Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Base URL for the API (defaults to http://localhost:3000)
# API_BASE_URL=https://cultscreener-api.onrender.com

# ===========================================
# Additional API Keys (Optional)
# ===========================================
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key
# JUPITER_API_KEY=your_jupiter_api_key

# ===========================================
# Advanced Tuning (Optional - defaults shown)
# ===========================================
# REQUEST_TIMEOUT_MS=30000
# ADMIN_REQUEST_TIMEOUT_MS=120000
# VIEW_BUFFER_MAX_SIZE=50000
# VIEW_FLUSH_INTERVAL_MS=5000
# API_QUEUE_MAX_SIZE=500
# API_QUEUE_TIMEOUT_MS=15000
# Bytes of proxied images this process may cache per TTL window, in MB
# IMAGE_PROXY_CACHE_BUDGET_MB=8
# Log every GeckoTerminal/Jupiter call (entry, counts, sample payloads); off by default
# DEBUG_API_LOGS=1
