# Dev-mode config for `npm run dev` in this package (Vite loads .env.development automatically).
# Without this file the dev server had NO VITE_API_URL at all, so client.ts's BASE_URL was
# undefined and every request went to "<origin>/undefined/..." - sign-in and the feed could
# never work locally. Values mirror .env.production's shape; see the comments there.

# TrenchScanner's API, run locally from that repo: `npm run dev:api` listens on
# http://localhost:4000 (its .env.example sets API_PORT=4000). Set that repo's
# CORS_ORIGINS/PUBLIC_APP_DOMAIN to this dev server's host:port (localhost:5173 by default),
# per its README's local-development section.
VITE_API_URL=http://localhost:4000

# The main HolDEX backend (image proxy), run locally from this repo's backend/ on port 3000.
VITE_SITE_API_URL=http://localhost:3000

# Read-only RPC for the wallet adapter's internal plumbing - same public endpoint as production.
VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
