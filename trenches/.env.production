# Build-time config for the Trenches SPA (frontend/trenches/).
# Vite inlines VITE_-prefixed values into the bundle at build time — these are public,
# client-visible values, not secrets. Never put an API key or signing secret in this file.

# TrenchScanner's own backend, on a subdomain of this site's own domain so the session
# cookie is first-party (Safari and Brave drop it cross-site). Separate service from the main
# HolDEX API (cultscreener-api.onrender.com) that the rest of the site talks to.
VITE_API_URL=https://api.holdex.live

# Read-only RPC used purely by the wallet adapter's internal plumbing; sign-in only ever
# signs a message, never submits a transaction. Left at the app's own default if unset.
VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
