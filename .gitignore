# Dependencies
node_modules/

# Abandoned directories
telegram-bot/

# Environment variables
.env
.env.local
.env.production
backend/.env
backend/.env.local
# telegram-bot/.env (removed)

# Exception: the Trenches SPA's build-time config must be committed, or Render's build
# produces a bundle with an undefined VITE_API_URL and the app fails at runtime. It holds
# only public, client-visible values (the API's public URL and a public RPC endpoint) —
# Vite would inline them into the shipped JS regardless. No secrets belong in this file.
!trenches/.env.production

# Logs
logs/
*.log
npm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Build outputs
dist/
build/
# Generated by `npm run build` (trenches/ -> frontend/trenches/) during Render's build step.
# Everything else under frontend/ is hand-authored and stays committed.
frontend/trenches/

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Temporary files
tmp/
temp/
*.tmp

# Database
*.sqlite
*.db
# telegram-bot/data/ (removed)

# Frontend env
frontend/.env

# Certificates / keys
*.pem
*.key
*.cert
